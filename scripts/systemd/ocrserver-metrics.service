[Unit]
Description=ocrserver host metrics snapshot
Wants=ocrserver-metrics.timer

[Service]
Type=oneshot
# Collects on the host (/proc, nvidia-smi) and POSTs the row to the wrapper
# (/internal/metrics, wrapper 0.3.14+), which owns metrics.db. The host never
# opens the DB file itself. No root needed any more.
User=jikhanjung
ExecStart=/usr/bin/python3 /srv/ocrserver/scripts/metrics_collector.py
Nice=10
IOSchedulingClass=idle
